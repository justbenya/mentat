{
  "printWidth": 120,
  "singleQuote": true,
  "quoteProps": "consistent",
  "trailingComma": "es5",
  "bracketSpacing": true,
  "tabWidth": 2,
  "semi": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "singleAttributePerLine": true,
  "overrides": [
    {
      "files": [
        "*.json",
        "*.json5",
        "*.yml",
        "*.yaml",
        "*.html",
        "*.htm",
        "*.ejs",
        "*.xml",
        "*.svg",
        "*.css",
        "*.less",
        "*.sass",
        "*.scss"
      ],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
